rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation helper for User Profile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email', 'createdAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 256)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024));
    }

    // Validation helper for Case File
    function isValidCaseFile(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'category', 'institution', 'status']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 256 &&
             data.category is string && data.category.size() <= 128 &&
             data.institution is string && data.institution.size() <= 256 &&
             data.status in ['Draft', 'Analyzed', 'Questions Prepared', 'Followed Up'] &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 10000)) &&
             (!('rawNotice' in data) || (data.rawNotice is string && data.rawNotice.size() <= 50000)) &&
             (!('dateReceived' in data) || (data.dateReceived is string && data.dateReceived.size() <= 128)) &&
             (!('keyDeadline' in data) || (data.keyDeadline is string && data.keyDeadline.size() <= 256)) &&
             (!('referenceNumber' in data) || (data.referenceNumber is string && data.referenceNumber.size() <= 128));
    }

    // Validation helper for Chat Session
    function isValidChatSession(data) {
      return data.keys().hasAll(['id', 'userId', 'role', 'model', 'messages']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.role is string && data.role.size() <= 128 &&
             data.model is string && data.model.size() <= 128 &&
             data.messages is list && data.messages.size() <= 500;
    }

    // Connection probe for client test
    match /test/connection {
      allow read: if true;
    }

    // User Profile collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId;
      allow delete: if isOwner(userId) && isValidId(userId);

      // Case Files subcollection
      match /caseFiles/{caseId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(caseId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(caseId) && isValidCaseFile(incoming());
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(caseId) && isValidCaseFile(incoming()) &&
                         incoming().userId == existing().userId && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(caseId);
      }

      // Chat Sessions subcollection
      match /chatSessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(sessionId) && isValidChatSession(incoming());
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(sessionId) && isValidChatSession(incoming()) &&
                         incoming().userId == existing().userId && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
      }
    }
  }
}
