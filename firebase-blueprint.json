{
  "entities": {
    "userProfile": {
      "title": "User Profile",
      "description": "User account information synchronized upon Google Sign-In.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 256 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "email", "createdAt"]
    },
    "caseFile": {
      "title": "Case File",
      "description": "User saved institutional decision notice and audit package.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "category": { "type": "string", "maxLength": 128 },
        "institution": { "type": "string", "maxLength": 256 },
        "dateReceived": { "type": "string", "maxLength": 128 },
        "keyDeadline": { "type": "string", "maxLength": 256 },
        "referenceNumber": { "type": "string", "maxLength": 128 },
        "status": { 
          "type": "string", 
          "enum": ["Draft", "Analyzed", "Questions Prepared", "Followed Up"] 
        },
        "notes": { "type": "string", "maxLength": 10000 },
        "rawNotice": { "type": "string", "maxLength": 50000 },
        "report": { "type": "object" },
        "activityTimeline": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "title", "category", "institution", "status"]
    },
    "chatSession": {
      "title": "Chat Session",
      "description": "Multi-turn Gemini chat conversation thread with institutional transparency advisor.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "maxLength": 128 },
        "model": { "type": "string", "maxLength": 128 },
        "messages": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "role", "model", "messages"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "userProfile",
      "description": "User profile document owned by the authenticated user."
    },
    "/users/{userId}/caseFiles/{caseId}": {
      "schema": "caseFile",
      "description": "Audited rejection notices, action checklists, and notes owned by the user."
    },
    "/users/{userId}/chatSessions/{sessionId}": {
      "schema": "chatSession",
      "description": "Multi-turn Gemini conversation threads with transparency advisors."
    }
  }
}
